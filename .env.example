# Database
DATABASE_URL="postgresql://user:password@localhost:5432/easytrust"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Stripe
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your@email.com"
SMTP_PASSWORD="your-app-password"
EMAIL_FROM="EasyTrust Legal <noreply@easytrust.com>"

# Attorney Info
ATTORNEY_NAME="Your Name, Esq."
ATTORNEY_BAR_NUMBER="Bar No. XXXXXX"
ATTORNEY_FIRM="Law Offices of [Name]"
ATTORNEY_ADDRESS="123 Main Street, City, CA 90000"
ATTORNEY_PHONE="(555) 555-5555"
ATTORNEY_EMAIL="attorney@easytrust.com"

# Service Price (in cents)
SERVICE_PRICE_CENTS="150000"

# Dropbox (for sharing executed docs)
DROPBOX_ACCESS_TOKEN="your-dropbox-token"
